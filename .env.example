# ---------------------------------------------------------------------------
# SMTP — Brevo relay (300 emails/day free tier)
# ---------------------------------------------------------------------------
# SMTP_USER is the Brevo *relay login* (b4c47f001@smtp-brevo.com for Vitharn).
# It is NOT the address recipients see. The visible From is SMTP_FROM, which
# must be a sender you verified in the Brevo dashboard.
#
# SPELLING: the mailbox is "vitarn.dev@gmail.com" — NO 'h' — even though the
# brand/display name is "Vitharn ERP Services". Do not add the 'h'.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b4c47f001@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=vitarn.dev@gmail.com
SMTP_FROM_NAME=Vitharn ERP Services
SMTP_REPLY_TO=vitarn.dev@gmail.com

# Optional escape hatch ONLY. Leave EMPTY for Brevo — Brevo's hostname resolves
# fine on Vercel. Setting a stale IP here silently sends mail to the wrong host.
SMTP_HOST_IP=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
QUOTE_TOKEN_SECRET=your-quote-token-secret
JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# Vitharn billing identity (printed on invoice PDFs)
# ---------------------------------------------------------------------------
VITHARN_UPI_ID=your-upi@oksbi
VITHARN_UPI_NAME=Aadi (Proprietor, Vitharn ERP Services)
VITHARN_BILLING_EMAIL=vitarn.dev@gmail.com
VITHARN_BILLING_PHONE=

# ---------------------------------------------------------------------------
# Telegram Bot (admin notifications)
# ---------------------------------------------------------------------------
# Bot token from @BotFather. Admin chat ID is your personal Telegram user ID
# (get it from @userinfobot or the getUpdates endpoint).
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-user-id
"VITHARN_UPI_ID=6304562779@nyes" 
