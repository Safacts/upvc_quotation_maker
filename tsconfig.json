{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/app/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify2/types/**/*.ts",
    ".next-verify2/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "website",
    "lib",
    "web",
    "android",
    "ios",
    "windows",
    "linux",
    "macos",
    "test",
    "sources",
    "docs",
    "assets",
    "backups",
    ".dart_tool"
  ]
}
