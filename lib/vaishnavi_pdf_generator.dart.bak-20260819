import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';
import 'package:http/http.dart' as http;
import 'package:intl/intl.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

import 'app_state.dart';
import 'models.dart';
import 'models_extra.dart';

const _defaultLogoUrl =
    'https://t3.ftcdn.net/jpg/08/52/27/60/360_F_852276023_G4klsazIrvQwxpJOsje5gDf8zqlWWEmQ.jpg';

Future<Uint8List> generateVaishnaviPdfBytes(
  QuotationData data,
  AppState appState, {
  List<QuotationPhoto> photos = const [],
}) async {
  final pdf = pw.Document();
  final currency = NumberFormat.currency(locale: 'en_IN', symbol: 'Rs. ');
  final config = appState.clientConfig;
  final logo = await _loadLogo(
    config.invoiceTopLogoUrl.isNotEmpty
        ? config.invoiceTopLogoUrl
        : config.logoUrl,
  );
  final regular = await PdfGoogleFonts.robotoRegular();
  final bold = await PdfGoogleFonts.robotoBold();
  final base =
      data.includeGst ? data.actualAmount + data.transport : data.grandTotal;
  final gst = data.includeGst ? data.grandTotal - base : 0.0;

  pdf.addPage(
    pw.MultiPage(
      pageTheme: pw.PageTheme(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.fromLTRB(28, 24, 28, 28),
        theme: pw.ThemeData.withFont(base: regular, bold: bold),
      ),
      header: (_) => _header(logo, appState, pw.FontWeight.bold),
      footer:
          (context) => pw.Container(
            margin: const pw.EdgeInsets.only(top: 8),
            padding: const pw.EdgeInsets.only(top: 5),
            decoration: const pw.BoxDecoration(
              border: pw.Border(top: pw.BorderSide(color: PdfColors.grey500)),
            ),
            child: pw.Text(
              'This is a computer-generated estimate | Page ${context.pageNumber} of ${context.pagesCount}',
              style: const pw.TextStyle(fontSize: 8, color: PdfColors.grey700),
            ),
          ),
      build:
          (_) => [
            _estimateMeta(data, pw.FontWeight.bold),
            pw.SizedBox(height: 8),
            _items(data, currency, pw.FontWeight.bold),
            pw.SizedBox(height: 8),
            _totals(data, base, gst, currency, pw.FontWeight.bold),
            pw.SizedBox(height: 8),
            _bank(appState, pw.FontWeight.bold),
            pw.SizedBox(height: 8),
            _description(pw.FontWeight.bold),
            pw.SizedBox(height: 8),
            _terms(data, appState, pw.FontWeight.bold),
            pw.SizedBox(height: 12),
            pw.Align(
              alignment: pw.Alignment.centerRight,
              child: pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.center,
                children: [
                  pw.Text(
                    'For: ${appState.companyName}',
                    style: pw.TextStyle(
                      fontWeight: pw.FontWeight.bold,
                      fontSize: 10,
                    ),
                  ),
                  pw.SizedBox(height: 24),
                  pw.Text(
                    'Authorized Signatory',
                    style: pw.TextStyle(fontSize: 9),
                  ),
                ],
              ),
            ),
          ],
    ),
  );
  return pdf.save();
}

pw.Widget _header(
  pw.ImageProvider logo,
  AppState appState,
  pw.FontWeight bold,
) {
  return pw.Column(
    children: [
      pw.Row(
        children: [
          pw.SizedBox(
            width: 62,
            height: 42,
            child: pw.Image(logo, fit: pw.BoxFit.contain),
          ),
          pw.SizedBox(width: 8),
          pw.Expanded(
            child: pw.Column(
              crossAxisAlignment: pw.CrossAxisAlignment.start,
              children: [
                pw.Text(
                  appState.companyName,
                  style: pw.TextStyle(fontSize: 16, fontWeight: bold),
                ),
                pw.Text(
                  appState.companyAddress,
                  style: const pw.TextStyle(fontSize: 8),
                ),
                pw.Text(
                  'GSTIN: ${appState.gstNumber}   State: 36-Telangana',
                  style: const pw.TextStyle(fontSize: 8),
                ),
              ],
            ),
          ),
          pw.Text(
            'Estimate',
            style: pw.TextStyle(fontSize: 15, fontWeight: bold),
          ),
        ],
      ),
      pw.Divider(thickness: 1),
    ],
  );
}

pw.Widget _estimateMeta(QuotationData data, pw.FontWeight bold) => pw.Row(
  mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
  children: [
    pw.Text(
      'Estimate For: ${data.customerName}',
      style: pw.TextStyle(fontSize: 9, fontWeight: bold),
    ),
    pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.end,
      children: [
        pw.Text(
          'Estimate No.: ${data.quotationNo}',
          style: pw.TextStyle(fontSize: 9, fontWeight: bold),
        ),
        pw.Text(
          'Date: ${DateFormat('dd-MM-yyyy').format(data.date)}',
          style: pw.TextStyle(fontSize: 9, fontWeight: bold),
        ),
      ],
    ),
  ],
);

pw.Widget _items(
  QuotationData data,
  NumberFormat currency,
  pw.FontWeight bold,
) {
  final rows = <List<String>>[];
  for (var i = 0; i < data.measuredItems.length; i++) {
    final item = data.measuredItems[i];
    rows.add([
      '${i + 1}',
      '${item.description}\n${item.width.toStringAsFixed(0)} mm x ${item.height.toStringAsFixed(0)} mm',
      '${item.units}',
      item.sft.toStringAsFixed(2),
      '-',
      item.glass.isEmpty ? '-' : item.glass,
      item.totalSft.toStringAsFixed(2),
      'Sqf',
      currency.format(item.rate),
      data.includeGst
          ? currency.format(item.total * data.gstPercentage / 100)
          : '-',
      currency.format(item.total),
    ]);
  }
  for (var i = 0; i < data.unmeasuredItems.length; i++) {
    final item = data.unmeasuredItems[i];
    rows.add([
      '${data.measuredItems.length + i + 1}',
      item.description,
      '${item.units}',
      '-',
      '-',
      '${item.units}',
      'Nos',
      currency.format(item.rate),
      data.includeGst
          ? currency.format(item.total * data.gstPercentage / 100)
          : '-',
      currency.format(item.total),
    ]);
  }
  return pw.TableHelper.fromTextArray(
    headers: const [
      '#',
      'Item Name',
      'Windows QTY',
      'Windows SQ FEET',
      'MESH',
      'Glass',
      'Quantity',
      'Unit',
      'Price / Unit',
      'GST',
      'Amount',
    ],
    data: rows,
    headerStyle: pw.TextStyle(fontSize: 7, fontWeight: bold),
    cellStyle: const pw.TextStyle(fontSize: 7),
    headerDecoration: const pw.BoxDecoration(color: PdfColors.grey200),
    border: pw.TableBorder.all(color: PdfColors.grey700, width: .5),
    cellAlignment: pw.Alignment.center,
    columnWidths: const {
      0: pw.FlexColumnWidth(.45),
      1: pw.FlexColumnWidth(3.2),
      2: pw.FlexColumnWidth(.8),
      3: pw.FlexColumnWidth(1),
      4: pw.FlexColumnWidth(.7),
      5: pw.FlexColumnWidth(.8),
      6: pw.FlexColumnWidth(1),
      7: pw.FlexColumnWidth(.7),
      8: pw.FlexColumnWidth(1.4),
      9: pw.FlexColumnWidth(1.5),
      10: pw.FlexColumnWidth(1.5),
    },
  );
}

pw.Widget _totals(
  QuotationData data,
  double base,
  double gst,
  NumberFormat currency,
  pw.FontWeight bold,
) {
  final taxRate = data.includeGst ? data.gstPercentage / 2 : 0.0;
  final lines = <List<String>>[
    ['Sub Total', currency.format(base)],
    if (data.includeGst)
      ['SGST @ ${taxRate.toStringAsFixed(1)}%', currency.format(gst / 2)],
    if (data.includeGst)
      ['CGST @ ${taxRate.toStringAsFixed(1)}%', currency.format(gst / 2)],
    ['Total', currency.format(data.grandTotal)],
  ];
  return pw.Align(
    alignment: pw.Alignment.centerRight,
    child: pw.Table(
      columnWidths: const {
        0: pw.FixedColumnWidth(150),
        1: pw.FixedColumnWidth(100),
      },
      border: pw.TableBorder.all(color: PdfColors.grey700, width: .5),
      children:
          lines
              .map(
                (line) => pw.TableRow(
                  children: [
                    pw.Padding(
                      padding: const pw.EdgeInsets.all(5),
                      child: pw.Text(
                        line[0],
                        textAlign: pw.TextAlign.right,
                        style: pw.TextStyle(fontSize: 9, fontWeight: bold),
                      ),
                    ),
                    pw.Padding(
                      padding: const pw.EdgeInsets.all(5),
                      child: pw.Text(
                        line[1],
                        textAlign: pw.TextAlign.right,
                        style: pw.TextStyle(fontSize: 9, fontWeight: bold),
                      ),
                    ),
                  ],
                ),
              )
              .toList(),
    ),
  );
}

pw.Widget _bank(AppState appState, pw.FontWeight bold) => pw.Column(
  crossAxisAlignment: pw.CrossAxisAlignment.start,
  children: [
    pw.Text('Pay To:', style: pw.TextStyle(fontWeight: bold, fontSize: 9)),
    pw.Text(
      'Bank Name: ${appState.bankName}, ${appState.bankBranch}',
      style: const pw.TextStyle(fontSize: 8),
    ),
    pw.Text(
      'Bank Account No.: ${appState.bankAccountNo}',
      style: const pw.TextStyle(fontSize: 8),
    ),
    pw.Text(
      'Bank IFSC code: ${appState.bankIfsc}',
      style: const pw.TextStyle(fontSize: 8),
    ),
    pw.Text(
      "Account Holder's Name: ${appState.companyName}",
      style: const pw.TextStyle(fontSize: 8),
    ),
  ],
);

pw.Widget _description(pw.FontWeight bold) => pw.Column(
  crossAxisAlignment: pw.CrossAxisAlignment.start,
  children: [
    pw.Text('Description', style: pw.TextStyle(fontWeight: bold, fontSize: 9)),
    pw.SizedBox(height: 3),
    pw.Text('Profile: "OASIS"', style: const pw.TextStyle(fontSize: 8)),
    pw.Text(
      'Supplying and fixing of Unplasticised Poly Vinyl Chloride (UPVC) windows and doors, including profiles, glass, mesh, hardware, labour, transportation, erection and installation at site, complete for finished item of work.',
      style: pw.TextStyle(fontSize: 8),
    ),
  ],
);

pw.Widget _terms(QuotationData data, AppState appState, pw.FontWeight bold) =>
    pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.start,
      children: [
        pw.Text(
          'Terms And Conditions',
          style: pw.TextStyle(fontWeight: bold, fontSize: 9),
        ),
        ...appState.clientConfig.termsAndConditions.asMap().entries.map(
          (e) => pw.Text(
            '${e.key + 1}) ${e.value}',
            style: const pw.TextStyle(fontSize: 8),
          ),
        ),
        pw.SizedBox(height: 5),
        pw.Text(
          'Estimate Amount In Words: ${data.amountInWords}',
          style: pw.TextStyle(fontSize: 8, fontWeight: bold),
        ),
      ],
    );

Future<pw.ImageProvider> _loadLogo(String configured) async {
  Future<pw.MemoryImage> fetch(String url) async {
    final response = await http.get(Uri.parse(url));
    if (response.statusCode != 200) {
      throw Exception('HTTP ${response.statusCode}');
    }
    return pw.MemoryImage(response.bodyBytes);
  }

  try {
    if (configured.isNotEmpty) {
      return await fetch(configured);
    }
  } catch (e) {
    debugPrint('Vaishnavi logo load failed: $e');
  }
  try {
    final bytes = await rootBundle.load('assets/logos/vaishnavi.jpg');
    return pw.MemoryImage(bytes.buffer.asUint8List());
  } catch (e) {
    debugPrint('Bundled Vaishnavi logo load failed: $e');
    return fetch(_defaultLogoUrl);
  }
}
